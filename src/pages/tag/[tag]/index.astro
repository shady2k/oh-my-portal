---
import Listing from '../../../components/Listing.astro';
import Mark from '../../../components/Mark.astro';
import Base from '../../../layouts/Base.astro';
import { getAuthor } from '../../../site.ts';
import { listPosts, listTags } from '../../../posts.ts';

/**
 * `/tag/<tag>/` — design §5.
 *
 * Only tags that are actually in use get a page. A tag with no posts would be a
 * 200 that says nothing, and the redirect map already sends the old empty tags
 * somewhere useful.
 *
 * The page is the front page with one chip lit. There is no second heading
 * announcing the tag: the lit chip already says which filter is on, and a
 * heading repeating it would be the same word twice in a row.
 */
export async function getStaticPaths() {
  const posts = await listPosts();
  const tags = await listTags();
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)), tags, total: posts.length },
  }));
}

const { tag, posts, tags, total } = Astro.props;
const author = await getAuthor();
---

<Base title={`Тема: ${tag}`} description={`Записи по теме ${tag}.`} feed={`/feeds/${tag}.xml`} wide>
  <h1 class="sr-only">Тема: {tag}</h1>

  <Mark name={author?.name} tags={tags} total={total} active={tag} />

  <Listing posts={posts} />

  <p class="feed">
    <a href={`/feeds/${tag}.xml`}>подписаться только на эту тему</a>
  </p>
</Base>

<style>
  .feed {
    margin-block-start: var(--space-5);
    font-family: var(--face-utility);
    font-size: var(--step--1);
  }
</style>
