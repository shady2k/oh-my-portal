---
import Listing from '../../../components/Listing.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import Tag from '../../../components/Tag.astro';
import Base from '../../../layouts/Base.astro';
import { listPosts, listTags } from '../../../posts.ts';

export async function getStaticPaths() {
  const posts = await listPosts();
  const tags = await listTags();
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)), tags, total: posts.length },
  }));
}

const { tag, posts, tags } = Astro.props;
---

{/* The tag leads: a search result and a tab both truncate from the right, and
    «Тема» is the one word on the line that distinguishes nothing. */}
<Base title={`${tag} · тема`} description={`Записи по теме ${tag}.`} feed={`/feeds/${tag}.xml`}>
  <PageHeader title={`Тема: ${tag}`} eyebrow="Журнал">
    <nav class="ui-topics" aria-label="Темы"><a href="/archive/">Все записи</a>{tags.map((item) => <Tag tag={item.tag} count={item.count} href={`/tag/${item.tag}/`} active={item.tag === tag} />)}</nav>
  </PageHeader>

  <Listing posts={posts} />

  <p class="feed">
    <a href={`/feeds/${tag}.xml`}>подписаться только на эту тему</a>
  </p>
</Base>

<style>
  .feed {
    margin-block-start: var(--space-5);
    font-family: var(--face-utility);
    font-size: var(--step--1);
  }
</style>
