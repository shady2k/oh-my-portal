---
import PageHeader from '../../components/ui/PageHeader.astro';
import Base from '../../layouts/Base.astro';
import Listing from '../../components/Listing.astro';
import Tag from '../../components/Tag.astro';
import { listPosts, listTags } from '../../posts.ts';
const posts = await listPosts();
const tags = await listTags();
---
<Base title="Весь журнал" description="Все статьи, заметки и эксперименты.">
  <PageHeader title="Весь журнал" eyebrow="Архив мастерской">
    <nav class="ui-topics" aria-label="Темы">{tags.map(({ tag, count }) => <Tag tag={tag} count={count} href={`/tag/${tag}/`} />)}</nav>
  </PageHeader>
  <Listing posts={posts} />
  {!posts.length && <p>Записей пока нет.</p>}
</Base>
