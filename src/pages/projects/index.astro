---
import { render } from 'astro:content';

import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import EditorialNote from '../../components/ui/EditorialNote.astro';
import ExperimentSketch from '../../components/ExperimentSketch.astro';
import ExperimentTrail from '../../components/ExperimentTrail.astro';
import { displayDate } from '../../dates.ts';
import { linkAttrs } from '../../links.ts';
import { getPage } from '../../posts.ts';
import { listProjects, STATE_LABEL } from '../../projects.ts';
import { projectPath } from '../../projections.ts';

/**
 * `/projects/` — R8, and §12's "a register with the state of each project, not
 * a link list".
 *
 * The state is the whole point. A list of repository links says nothing a
 * profile page would not, and it goes stale without a reader being able to tell.
 * A register that says `в архиве` since a date is still true a year later.
 */
const projects = await listProjects();
const page = await getPage('projects');
const Content = page ? (await render(page)).Content : null;

const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base
  title={page?.data.title ?? 'Проекты'}
  description={page?.data.summary ?? 'Реестр проектов с состоянием каждого.'}
>
  <article data-pagefind-body>
    <PageHeader title={page?.data.title ?? 'Проекты'} />

    {Content && <div class="prose ui-reading"><Content /></div>}

    <ul class="register">
      {
        projects.map(({ id, data }) => (
          <li id={id}>
            <div class:list={['ui-editorial', { 'has-art': !!data.sketch }]}>
              <div>
                <div class="project-meta utility">
                  <span class={`state state-${data.state}`}>{STATE_LABEL[data.state]}</span>
                  {data.since && <time datetime={iso(data.since)}>с {displayDate(data.since)}</time>}
                </div>
                <h2><a href={projectPath({ id })}>{data.title}</a></h2>
                <p class="summary ui-reading">{data.summary}</p>
                {data.stages && <ExperimentTrail stages={data.stages} />}
                {data.observation && <div class="observation"><EditorialNote label="Последнее наблюдение" accent>{data.observation}</EditorialNote></div>}
                {!data.sketch && data.question && <div class="question"><EditorialNote label="Открытый вопрос">{data.question}</EditorialNote></div>}
                <p class="links" data-pagefind-ignore>
                  <a href={projectPath({ id })}>Страница проекта</a>
                  {data.repo && <a href={data.repo} {...linkAttrs(data.repo, Astro.site)}>Исходники</a>}
                  {data.site && <a href={data.site} {...linkAttrs(data.site, Astro.site)}>Сайт проекта</a>}
                </p>
              </div>
              {data.sketch && <aside class="ui-editorial-aside">
                <ExperimentSketch sketch={data.sketch} compact />
                {data.question && <div class="question"><EditorialNote label="Открытый вопрос">{data.question}</EditorialNote></div>}
              </aside>}
            </div>
          </li>
        ))
      }
    </ul>

    {projects.length === 0 && <p class="utility">Реестр пуст: контент-репозиторий не подключён.</p>}
  </article>
</Base>

<style>
  .register { list-style: none; padding: 0; margin: 0; }
  .register > li + li { margin-block-start: var(--space-4); padding-block-start: var(--space-4); border-block-start: 1px solid var(--rule); }
  .project-meta { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); margin-block-end: 1rem; }
  h2 { font-size: var(--title-feature); max-inline-size: 22ch; margin: 0 0 1rem; }
  h2 a { text-decoration: none; }
  h2 a:hover, h2 a:focus-visible { text-decoration: underline; text-decoration-thickness: 1px; }
  .ui-editorial:not(.has-art) h2 { font-size: var(--step-2); max-inline-size: var(--measure); }
  .state { color: var(--ink); }
  .state-archived { color: var(--ink-quiet); }
  .summary { color: var(--ink-quiet); font-size: 1.125rem; line-height: 1.55; }
  .observation { margin-block: var(--space-3); }
  .question { margin-block: 1rem; }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-3) 0 0; }
</style>
