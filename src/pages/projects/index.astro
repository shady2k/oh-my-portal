---
import { render } from 'astro:content';

import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import EditorialNote from '../../components/ui/EditorialNote.astro';
import ExperimentSketch from '../../components/ExperimentSketch.astro';
import ExperimentTrail from '../../components/ExperimentTrail.astro';
import { displayDate } from '../../dates.ts';
import { getPage } from '../../posts.ts';
import { listProjects, STATE_LABEL } from '../../site.ts';

/**
 * `/projects/` — R8, and §12's "a register with the state of each project, not
 * a link list".
 *
 * The state is the whole point. A list of repository links says nothing a
 * profile page would not, and it goes stale without a reader being able to tell.
 * A register that says `в архиве` since a date is still true a year later.
 */
const projects = await listProjects();
const page = await getPage('projects');
const Content = page ? (await render(page)).Content : null;

const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base
  title={page?.data.title ?? 'Проекты'}
  description={page?.data.summary ?? 'Реестр проектов с состоянием каждого.'}
>
  <article data-pagefind-body>
    <PageHeader title={page?.data.title ?? 'Проекты'} />

    {Content && <div class="prose ui-reading"><Content /></div>}

    <ul class="register">
      {
        projects.map((project) => (
          <li id={project.slug}>
            <div class:list={['ui-editorial', { 'has-art': !!project.sketch }]}>
              <div>
                <div class="project-meta utility">
                  <span class={`state state-${project.state}`}>{STATE_LABEL[project.state]}</span>
                  {project.since && <time datetime={iso(project.since)}>с {displayDate(project.since)}</time>}
                </div>
                <h2>{project.name}</h2>
                <p class="summary ui-reading">{project.summary}</p>
                {project.stages && <ExperimentTrail stages={project.stages} />}
                {project.observation && <div class="observation"><EditorialNote label="Последнее наблюдение" accent>{project.observation}</EditorialNote></div>}
                {!project.sketch && project.question && <div class="question"><EditorialNote label="Открытый вопрос">{project.question}</EditorialNote></div>}
                {(project.repo || project.site) && <p class="links" data-pagefind-ignore>
                  {project.repo && <a href={project.repo}>Исходники</a>}
                  {project.site && <a href={project.site}>Сайт проекта</a>}
                </p>}
              </div>
              {project.sketch && <aside class="ui-editorial-aside">
                <ExperimentSketch sketch={project.sketch} compact />
                {project.question && <div class="question"><EditorialNote label="Открытый вопрос">{project.question}</EditorialNote></div>}
              </aside>}
            </div>
          </li>
        ))
      }
    </ul>

    {projects.length === 0 && <p class="utility">Реестр пуст: контент-репозиторий не подключён.</p>}
  </article>
</Base>

<style>
  .register { list-style: none; padding: 0; margin: 0; }
  .register > li + li { margin-block-start: var(--space-4); padding-block-start: var(--space-4); border-block-start: 1px solid var(--rule); }
  .project-meta { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); margin-block-end: 1rem; }
  h2 { font-size: var(--title-feature); max-inline-size: 22ch; margin: 0 0 1rem; }
  .ui-editorial:not(.has-art) h2 { font-size: var(--step-2); max-inline-size: var(--measure); }
  .state { color: var(--ink); }
  .state-archived { color: var(--ink-quiet); }
  .summary { color: var(--ink-quiet); font-size: 1.125rem; line-height: 1.55; }
  .observation { margin-block: var(--space-3); }
  .question { margin-block: 1rem; }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-3) 0 0; }
</style>
