---
import PageHeader from '../../../../components/ui/PageHeader.astro';
import Base from '../../../../layouts/Base.astro';
import { fileHistory, twinHash } from '../../../../history.ts';
import { listPosts, type Post } from '../../../../posts.ts';

/**
 * `/posts/<slug>/integrity/` — provenance for one article.
 *
 * Design §1 puts the source of truth in a markdown file in git, and this is that
 * decision made checkable: the hash of exactly what the twin serves, and the
 * commits that touched the file. Both are facts a reader can verify without
 * trusting the site — the hash against the twin, the commits against the
 * repository — which is the only kind of claim worth publishing about oneself.
 */
export async function getStaticPaths() {
  const posts = await listPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const hash = twinHash(post, Astro.site!);
const revisions = fileHistory(post.filePath);
const file = post.filePath?.split('/').pop() ?? `${post.id}.md`;
---

<Base
  title={`Провенанс: ${post.data.title}`}
  description={`Хеш markdown-твина и история правок файла ${file}.`}
  noindex
>
  <PageHeader title={post.data.title} eyebrow={`Провенанс · ${file}`} />
  <div class="ui-reading">

  <p class="lead">
    Статьи не правятся втихую. Ниже — хеш того, что отдаётся по адресу
    <a href={`/posts/${post.id}.md`}>/posts/{post.id}.md</a>, и коммиты, которые
    трогали файл.
  </p>

  <p class="label">sha256</p>
  <p class="hash">{hash}</p>
  <p class="verify">
    Проверить: <code>curl -s {new URL(`/posts/${post.id}.md`, Astro.site)} | sha256sum</code>
  </p>

  <p class="label">правки</p>
  {
    revisions.length > 0 ? (
      <ol class="revisions">
        {revisions.map(({ date, hash: commit }) => (
          <li>
            <time datetime={date}>{date}</time>
            <span class="commit">{commit}</span>
          </li>
        ))}
      </ol>
    ) : (
      <p class="absent">
        История недоступна: сборка идёт без git-истории файла — так бывает при
        поверхностном клоне. Хеш выше от этого не менее проверяем.
      </p>
    )
  }

  <p class="back"><a href={`/posts/${post.id}/`}>← к статье</a></p>
  </div>
</Base>

<style>
  .file,
  .label,
  .hash,
  .verify,
  .revisions,
  .back,
  .absent {
    font-family: var(--face-utility);
    font-size: var(--step--1);
  }

  .file {
    margin: 0;
    color: var(--ink-quiet);
  }

  h1 {
    margin-block: var(--space-2) var(--space-3);
  }

  .lead {
    max-inline-size: var(--measure);
    margin-block: 0 var(--space-5);
    color: var(--ink-quiet);
  }

  /* A chip, so the two sections read as the two facts they are. */
  .label {
    display: inline-block;
    background: var(--paper-sunk);
    border: 1px solid var(--rule);
    padding: 0.2em 0.55em;
    margin-block: 0 var(--space-3);
  }

  .hash {
    /* The whole point is that it can be copied and compared, so it never wraps
       mid-run in a way that hides a character. */
    overflow-wrap: anywhere;
    font-size: var(--step-0);
    margin-block: 0 var(--space-2);
  }

  .verify,
  .absent {
    overflow-wrap: anywhere;
    max-inline-size: var(--measure);
    margin-block: 0 var(--space-5);
    color: var(--ink-quiet);
  }

  .revisions {
    list-style: none;
    padding: 0;
    margin-block: 0 var(--space-5);
    display: grid;
    gap: var(--space-1);
  }

  .revisions li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .revisions time {
    font-variant-numeric: tabular-nums;
  }

  .commit {
    color: var(--ink-quiet);
  }

  .back {
    margin: 0;
  }
</style>
