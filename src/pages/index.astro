---
import Pill from '../components/Pill.astro';
import Base from '../layouts/Base.astro';
import { listPosts, listTags } from '../posts.ts';

const posts = await listPosts();
const tags = await listTags();

const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title="Записи" description="Записи о домашней инфраструктуре, инструментах и агентах.">
  <h1 class="highlight"><span>Записи</span></h1>

  {
    tags.length > 0 && (
      <nav class="tags" aria-label="темы">
        {tags.map(({ tag, count }) => (
          <span class="tag-item">
            <Pill tag={tag} href={`/tag/${tag}/`} />
            <span class="utility count">{count}</span>
          </span>
        ))}
      </nav>
    )
  }

  <ul class="list">
    {
      posts.map((post) => (
        <li>
          <article>
            <h2 class="title">
              <a href={`/posts/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="summary">{post.data.summary}</p>
            <p class="utility line">
              <time datetime={iso(post.data.date)}>{iso(post.data.date)}</time>
              {post.data.recipe && <span> · со структурным ядром</span>}
              {post.data.status === 'draft' && <span> · черновик</span>}
            </p>
          </article>
        </li>
      ))
    }
  </ul>

  {posts.length === 0 && <p class="utility">Ни одной записи: контент-репозиторий не подключён.</p>}
</Base>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-end: var(--space-4);
  }

  .tag-item {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-1);
  }

  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list > li + li {
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--rule);
  }

  .title {
    font-size: var(--step-1);
    margin-block: 0 var(--space-1);
  }

  .summary {
    margin-block-end: var(--space-1);
  }

  .line {
    margin: 0;
  }
</style>
