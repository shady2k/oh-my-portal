---
import TypedHeadline from '../components/ui/TypedHeadline.astro';
import EditorialNote from '../components/ui/EditorialNote.astro';
import Listing from '../components/Listing.astro';
import Tag from '../components/Tag.astro';
import { displayDate } from '../dates.ts';
import ExperimentSketch from '../components/ExperimentSketch.astro';
import JournalSketch from '../components/JournalSketch.astro';
import Revision from '../components/Revision.astro';
import PencilRule from '../components/PencilRule.astro';
import Base from '../layouts/Base.astro';
import { getAuthor, listProjects, STATE_LABEL } from '../site.ts';
import { siteName } from '../seo.ts';
import { displayHeading } from '../typography.ts';
import { listPosts, listTags } from '../posts.ts';

const posts = await listPosts();
const tags = await listTags();
const author = await getAuthor();
const projects = await listProjects();
const project = projects.find((p) => p.featured) ?? projects.find((p) => p.state === 'active' || p.state === 'experiment');
const currentStage = project?.stages?.find((stage) => stage.state === 'current');
const hasArt = !!project?.sketch;
const latest = posts[0];
const being = posts.find((p) => p.data.author === 'being');
const changed = posts.flatMap((post) => (post.data.revisions ?? []).map((revision) => ({ post, revision })))
  .sort((a, b) => b.revision.date.getTime() - a.revision.date.getTime())[0];
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base
  title={siteName(author)}
  tagline={displayHeading(author?.headline ?? 'Идеи, которые стали опытом')}
  description="Записи о домашней инфраструктуре, инструментах и агентах."
>
  <header class="intro">
    <div class="intro-copy">
    <p class="field-label journal-name">Полевой журнал</p>
    <TypedHeadline text={author?.headline ?? 'Идеи, которые стали опытом'} />
    {author?.bio && <p class="intro-text">{author.bio}</p>}
    </div>
    <a class="journal-jump" href="#journal">К свежим записям <span aria-hidden="true">↓</span></a>
  </header>

  {(project || latest) && (
    <section class:list={['feature', 'ui-editorial', { 'has-art': hasArt }]} aria-labelledby="feature-title">
      <div class="feature-rule"><PencilRule /></div>
      <div class="feature-copy">
        <p class="field-label feature-heading">
          {project ? 'Открытый эксперимент' : 'Последняя запись'}{project && <>, {currentStage
            ? <>этап: <a href={`/posts/${currentStage.post}/`}>{currentStage.title}</a></>
            : STATE_LABEL[project.state].toLowerCase()}</>}
        </p>
        <h2 id="feature-title"><a href={project ? `/projects/#${project.slug}` : `/posts/${latest!.id}/`}>{project?.name ?? latest!.data.title}</a></h2>
        <p class="feature-summary">{project?.summary ?? latest!.data.summary}</p>
        {!project && <p class="feature-meta utility">
            <time datetime={iso(latest!.data.date)}>{displayDate(latest!.data.date)}</time>
            {latest!.data.status === 'draft' && <span>черновик</span>}
        </p>}
        {project?.observation && <div class="observation"><EditorialNote label="Последнее наблюдение" accent>{project.observation}</EditorialNote></div>}
        <a class="read-link" href={project ? `/projects/#${project.slug}` : `/posts/${latest!.id}/`}>{project ? 'Как идёт эксперимент' : 'Читать запись'}</a>
      </div>
      {project && hasArt && (
        <aside class="feature-art ui-editorial-aside">
          <ExperimentSketch sketch={project.sketch!} compact />
        </aside>
      )}
      {project?.question && <p class="feature-question">{project.question}</p>}
    </section>
  )}

  <section id="journal" aria-labelledby="journal-title">
    <div class="journal-head">
      <h2 id="journal-title" class="field-label">Свежие записи</h2>
      <a class="journal-all" href="/archive/">Весь журнал</a>
    </div>
    <Listing posts={posts.slice(0, 3)} compact showSummary />
    {posts.length === 0 && <p class="empty">Ни одной записи: контент-репозиторий не подключён.</p>}
  </section>
  {changed && <Revision revision={changed.revision} author={changed.post.data.author} href={`/posts/${changed.post.id}/#revisions`} title={changed.post.data.title} insert />}

  <nav class="browse" aria-label="Продолжить чтение">
    <div><p class="field-label">Темы журнала</p><div class="topics">{tags.map(({ tag, count }) => <Tag tag={tag} count={count} href={`/tag/${tag}/`} />)}</div></div>
    <div class="follow">
      <JournalSketch />
      <div><a href="/rss/index.xml">Подписаться на журнал</a><p>Новые записи через RSS.</p></div>
    </div>
  </nav>

  {being && (
    <section class="resident">
      <span class="resident-mark" aria-hidden="true">✳</span>
      <div><p class="field-label">Журнал агента</p><h2>{being.data.title}</h2>
      <p>{being.data.summary}</p><a href={`/posts/${being.id}/`}>Читать наблюдение</a></div>
    </section>
  )}
</Base>

<style>
  .empty {
    color: var(--ink-quiet);
  }
  .intro { display: grid; gap: 0.5rem; padding-block: 0.5rem 0.75rem; }
  .intro-copy { min-inline-size: 0; }
  /* The masthead is the one label set in the data face and in capitals: a stamp on the cover, not a caption. */
  .intro .journal-name { margin-block: 0 0.625rem; font-family: var(--face-utility); font-size: var(--step--1); font-weight: 400; text-transform: uppercase; letter-spacing: 0.08em; }
  .intro-text { max-inline-size: 44rem; color: var(--ink-quiet); font-size: 1rem; margin: 0; }
  .journal-jump { justify-self: start; font-size: 0.875rem; padding-block: 0.25rem; }
  .journal-jump span { margin-inline-start: 0.5rem; }
  .observation { max-inline-size: 34rem; margin-block: 1.5rem; }
  #journal { padding-block-end: 0; }
  .browse { display: flex; flex-wrap: wrap; gap: 1.75rem 3rem; justify-content: space-between; align-items: center; padding-block: 2.5rem 0; font-size: 0.9375rem; }
  .browse .topics { padding: 0; }
  .follow { display: flex; align-items: center; gap: 1rem; }
  .follow a { font-size: 1.125rem; font-weight: 600; line-height: 1.4; }
  .follow p { font-size: 0.875rem; color: var(--ink-quiet); margin: 0.375rem 0 0; }
  .feature { position: relative; display: grid; align-items: start; column-gap: var(--layout-gap); row-gap: 1.75rem; padding-block: 1rem 1.75rem; margin-block: 0.25rem 0.75rem; }
  .feature-rule { position: absolute; inset-inline: 0; inset-block-end: 0; pointer-events: none; }
  .feature-copy { min-inline-size: 0; padding-block-start: 0.5rem; }
  .feature-heading { margin: 0 0 1rem; }
  .feature h2 { max-inline-size: 19ch; font-size: var(--title-feature); line-height: 1.12; letter-spacing: -0.04em; margin: 0 0 1rem; }
  .feature h2 a { text-decoration: none; }
  .feature h2 a:hover, .feature h2 a:focus-visible { text-decoration: underline; text-decoration-thickness: 1px; }
  .feature-summary { color: var(--ink-quiet); max-inline-size: 33rem; font-size: 1.125rem; line-height: 1.55; margin: 0; }
  .feature-meta { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .read-link { display: inline-block; font-size: 1rem; margin-block-start: 0.5rem; }
  .feature-art { min-inline-size: 0; }
  /*
   * The project's open question closes the experiment block without a label:
   * a question mark and italics say what it is. It is the one italic on the
   * page, which is what lets it read as the author thinking aloud.
   */
  .feature-question { grid-column: 1 / -1; max-inline-size: 42rem; margin: 0; font-style: italic; font-size: clamp(1.25rem, 1.7vw, 1.5rem); line-height: 1.3; letter-spacing: -0.015em; }
  #journal { min-inline-size: 0; }
  .journal-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem; padding-block: 0.75rem 0.625rem; }
  .journal-head h2 { margin: 0; font-family: var(--face-prose); font-size: 1.25rem; font-weight: 600; color: var(--ink); }
  .journal-all { font-size: 0.9375rem; }
  .topics { display: flex; flex-wrap: wrap; gap: 0.5rem; padding-block-end: 1.5rem; }
  .resident { display: flex; gap: 2rem; padding-block: 3rem 0; }
  .resident h2 { margin-block: 0 1rem; }
  .resident-mark { font-size: 4rem; color: var(--being); }
  @media (max-width: 44rem) {
    .intro { gap: 0.5rem; padding-block: 0.75rem; }
    .journal-jump { justify-self: start; }
    .feature-art { max-inline-size: 21rem; margin-inline: auto; }
    .feature, .feature.has-art { grid-template-columns: 1fr; padding: 1rem 0 1.75rem; gap: 1.5rem; }
    .feature-copy { display: contents; }
    .feature-heading, .feature h2 { margin-block: 0; }
    .feature-art { order: 1; }
    .feature .observation { order: 2; margin-block: 0; }
    .feature .feature-question { order: 3; }
    .feature .read-link { order: 4; margin-block-start: 0; justify-self: start; }
    .feature h2 { max-inline-size: 22ch; }
    .follow { gap: 0.75rem; }
  }
</style>
