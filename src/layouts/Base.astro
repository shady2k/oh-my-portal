---
import { getAuthor } from '../site.ts';
import { type ArticleMeta, ogLocale, pageTitle, siteName, structuredData } from '../seo.ts';
import '../styles/base.css';

import ThemeInit from '../components/ui/ThemeInit.astro';
import ThemePicker from '../components/ui/ThemePicker.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';
import ImageViewer from '../components/ui/ImageViewer.astro';

/** One outer frame on every page; reading measures belong to the content. */
interface Props {
  title: string;
  description: string;
  /** Design §5: authoritative per page, and it drives hreflang. */
  lang?: string;
  /** Kept out of search for drafts and for the not-found page. */
  noindex?: boolean;
  /** A narrower feed than /rss/ — a tag page advertises its own (R6). */
  feed?: string;
  /** The homepage only: it titles itself with the site's name, then this. */
  tagline?: string;
  /** An article: the frontmatter facts `article:*` and BlogPosting want. */
  article?: ArticleMeta;
}

const { title, description, lang = 'ru', noindex = false, feed, tagline, article } = Astro.props;

/* R3: a way to make contact, visible from any page — the footer is every page.
   It supplies the site's name too, so the head and the wordmark cannot disagree. */
const author = await getAuthor();
const site = siteName(author);

const canonical = new URL(Astro.url.pathname, Astro.site);
const origin = new URL('/', Astro.site);

/*
 * One card for the whole site, not one per article.
 *
 * Per-post cards need the image pipeline that does not exist yet
 * (oh-my-portal-xts); this is the fallback that has to exist first, and a link
 * with no card at all is what every share into a chat window looked like until
 * now. `scripts/og-card.ts` builds it from the same tokens and faces the site
 * uses, so it cannot drift into looking like somebody else's site.
 */
const card = new URL('/og.png', Astro.site);

/* Nothing structured on a page that asked not to be indexed — drafts, /search/
   and the 404. Describing yourself to a crawler you just turned away is the same
   contradiction as listing a noindex address in the sitemap. */
const structured = noindex ? [] : structuredData({
  title,
  description,
  canonical,
  site: origin,
  siteName: site,
  lang,
  authorName: author?.name,
  article,
});
/*
 * Design §6: `<link rel="alternate">` for clients that read the head rather than
 * negotiating. Directory addresses only — those are the ones that have a twin.
 */
const path = Astro.url.pathname;
const markdown = path.endsWith('/') ? `${path}index.md` : null;

const sections = [
  { href: '/archive/', label: 'журнал', match: (p: string) => p.startsWith('/archive/') || p.startsWith('/posts/') || p.startsWith('/tag/') },
  { href: '/projects/', label: 'проекты', match: (p: string) => p.startsWith('/projects/') },
  { href: '/about/', label: 'о себе', match: (p: string) => p.startsWith('/about/') },
  { href: '/search/', label: 'поиск', match: (p: string) => p.startsWith('/search/') },
];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <ThemeInit />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle(title, site, tagline)}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {/* Absent rather than a placeholder when no content repository is mounted. */}
    {author && <meta name="author" content={author.name} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/*
      The paper tokens, spelled out: `content` cannot read a custom property, so
      these two are the one place in the project where a colour is duplicated
      out of tokens.css. Changing --paper without changing these leaves a phone's
      address bar the wrong colour — nothing else breaks, which is exactly why
      it would go unnoticed.
    */}
    <meta name="theme-color" content="#fdfbf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d1e1c" media="(prefers-color-scheme: dark)" />
    {/*
      Design §5: the default locale is unprefixed, so x-default points at this
      same tree. When an /en/ tree appears, it adds an entry here and nothing
      about these addresses changes.
    */}
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    {feed && <link rel="alternate" type="application/rss+xml" title={title} href={feed} />}
    <link rel="alternate" type="application/rss+xml" title="Все записи" href="/rss/" />

    {/*
      Design §6 gave agents llms.txt, markdown twins and /index.json, and a
      person pasting a link into Telegram got a bare URL. These are the same
      three facts the head already states, in the vocabulary an unfurler reads.

      og:title is the bare page title: every client renders og:site_name beside
      it, so the composed title would say the site's name twice.
    */}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site} />
    <meta property="og:locale" content={ogLocale(lang)} />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* What the card actually says, word for word. It is one fixed image, so
        alt text derived from the page — or from the author's name, which the
        card does not carry — would describe something the reader is not seeing. */}
    <meta
      property="og:image:alt"
      content="Полевой журнал — домашняя инфраструктура, инструменты и ИИ-агенты"
    />

    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.modified && (
            <meta property="article:modified_time" content={article.modified.toISOString()} />
          )}
          {/* §8: see ArticleMeta.byHuman — an article the inhabitant wrote
              carries no author here rather than the maintainer's name. */}
          {article.byHuman && author && <meta property="article:author" content={author.name} />}
          {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={card} />

    {structured.map((block) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <a class="skip utility" href="#main">к содержанию</a>

    <header class="frame site-header">
      <a class="wordmark" href="/">{site}</a>
      {/* The content repository supplies the identity; navigation stays shared. */}
      <nav class="masthead" aria-label="разделы">
        {
          sections.map((section) => {
            const here = section.match(path);
            return (
              <a href={section.href} class:list={[{ here }]} aria-current={here ? 'page' : undefined}>
                {section.label}
              </a>
            );
          })
        }
      </nav>
      <ThemePicker />
    </header>

    <main id="main" class="frame">
      <slot />
    </main>

    <SiteFooter author={author} />
    <ImageViewer />

    <script>
      /*
       * `/` reaches search from anywhere — the habit every reader of this site
       * already has. It is deliberately unadvertised: the page says nothing
       * about it, so it costs no space, and a reader who does not know it loses
       * nothing that the search link in the header does not already give.
       */
      const typing = (el: Element | null) =>
        el instanceof HTMLElement &&
        (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'SELECT' || el.isContentEditable);

      document.addEventListener('keydown', (event) => {
        if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
        if (typing(document.activeElement) || document.querySelector('dialog[open]')) return;

        const box = document.querySelector<HTMLInputElement>('#q');
        event.preventDefault();

        /* Pagefind may have failed to load, leaving the form hidden. Then the
           box is not somewhere to send anyone — the page is. */
        if (box && box.getClientRects().length > 0) {
          box.focus();
          box.select();
          return;
        }
        window.location.href = '/search/';
      });

    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    inset-inline-start: -100vw;
  }

  .skip:focus {
    position: static;
    display: inline-block;
    padding: var(--space-2);
  }

  main {
    padding-block-end: var(--space-5);
  }

  /*
   * Name on the left, sections on the right, one line, no rule under it. A rule
   * would draw a box around the page; the space below is enough of a boundary.
   */
  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    padding-block: var(--space-3);
    font-family: var(--face-utility);
    font-size: var(--step--1);
    color: var(--ink-quiet);
  }

  .masthead {
    justify-content: flex-end;
    font-family: var(--face-prose);
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .site-header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }

  .wordmark {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  @media (max-width: 40rem) {
    .site-header { grid-template-columns: minmax(0, 1fr) auto; gap: 0 var(--space-2); }
    .site-header > :global(.theme-picker) { grid-column: 2; grid-row: 1; }
    .masthead { grid-column: 1 / -1; grid-row: 2; }
    .masthead { justify-content: flex-start; padding-block: var(--space-2); gap: 1.25rem; }
    .wordmark { padding-block-start: var(--space-2); }
  }

  .masthead a { text-decoration: none; }
  .masthead a:hover, .masthead a:focus-visible { text-decoration: underline; }

  .masthead a.here {
    color: var(--ink);
  }
</style>
