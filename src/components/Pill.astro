---
/**
 * A pastel section label — design §12.
 *
 * The colour is derived from the tag itself rather than passed in, so the same
 * tag is the same colour on every page without anyone maintaining a mapping in
 * two places. An unknown tag falls back to the neutral pill instead of being an
 * error: the taxonomy changes more often than this component.
 */
interface Props {
  tag: string;
  href?: string;
}

const { tag, href } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class="pill" style={`--pill: var(--pill-${tag}, var(--pill-default))`} {...href ? { href } : {}}>
  {tag}
</Tag>

<style>
  .pill {
    display: inline-block;
    background: var(--pill);
    color: var(--ink);
    font-family: var(--face-utility);
    font-size: var(--step--1);
    line-height: 1.4;
    padding: 0.15em 0.6em;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
  }

  a.pill:hover,
  a.pill:focus-visible {
    /* No shadow and no lift: the only affordance is the ink going solid. */
    box-shadow: inset 0 0 0 1px var(--ink);
  }
</style>
