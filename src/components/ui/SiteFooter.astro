---
import type { Author } from '../../schema/site.ts';
interface Props { author?: Author | null; }
const { author } = Astro.props;
const year = new Date().getUTCFullYear();
---
<footer class="frame site-footer" data-pagefind-ignore>
  <p>{author ? <>© {year} <a href="/about/">{author.name}</a></> : 'Полевой журнал'}</p>
  <nav aria-label="Информация о сайте">
    <a href="/about/">Об авторе</a>
    {author && <a href={author.contact.href}>{author.contact.label}</a>}
    <a href="/rss/index.xml">RSS</a>
  </nav>
</footer>
<style>
  .site-footer { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--space-2) var(--space-3); border-block-start: 1px solid var(--rule); padding-block: var(--space-3) var(--space-4); color: var(--ink-quiet); font-size: 0.875rem; }
  p { margin: 0; }
  nav { display: flex; flex-wrap: wrap; gap: var(--space-3); }
</style>
