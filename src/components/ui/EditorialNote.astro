---
/* The styles live in styles/ui.css, not here: an article's marked takeaway
   (src/takeaways.ts) renders the same note from markdown, and one note must not
   have two implementations of its look. */
interface Props { label: string; accent?: boolean; }
const { label, accent = false } = Astro.props;
---
<div class:list={['editorial-note', { accent }]}>
  <p class="field-label">{label}</p>
  <p class="note-text"><slot /></p>
</div>
