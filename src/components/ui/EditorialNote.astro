---
interface Props { label: string; accent?: boolean; }
const { label, accent = false } = Astro.props;
---
<div class:list={['editorial-note', { accent }]}>
  <p class="field-label">{label}</p>
  <p class="note-text"><slot /></p>
</div>
<style>
  .editorial-note { border-inline-start: 1px solid var(--rule); padding-inline-start: 1rem; font-size: 0.9375rem; line-height: 1.45; }
  p { margin: 0; }
  .field-label { margin-block-end: 0.375rem; }
  .accent { border-inline-start: 2px solid var(--accent); font-size: 1.125rem; line-height: 1.55; }
  .accent .field-label { color: var(--accent); margin-block-end: 0.5rem; }
</style>
