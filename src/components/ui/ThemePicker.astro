<fieldset class="theme-picker" hidden>
  <legend class="sr-only">Цветовая тема</legend>
  <label title="Как в системе">
    <input class="sr-only" type="radio" name="theme" value="system" aria-label="Как в системе" checked />
    <span class="theme-option"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="1" /><path d="M8 20h8m-4-4v4" /></svg></span>
  </label>
  <label title="Светлая тема">
    <input class="sr-only" type="radio" name="theme" value="light" aria-label="Светлая тема" />
    <span class="theme-option"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg></span>
  </label>
  <label title="Тёмная тема">
    <input class="sr-only" type="radio" name="theme" value="dark" aria-label="Тёмная тема" />
    <span class="theme-option"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A9 9 0 0 1 9.5 3.5a9 9 0 1 0 11 11Z" /></svg></span>
  </label>
</fieldset>
<script>
  const picker = document.querySelector<HTMLFieldSetElement>('.theme-picker')!;
  const choices = picker.querySelectorAll<HTMLInputElement>('input[name="theme"]');
  const apply = (value: string | null) => {
    const theme = value === 'light' || value === 'dark' ? value : 'system';
    if (theme === 'system') delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = theme;
    choices.forEach((choice) => { choice.checked = choice.value === theme; });
  };
  apply(document.documentElement.dataset.theme ?? null);
  picker.hidden = false;
  picker.addEventListener('change', (event) => {
    if (!(event.target instanceof HTMLInputElement)) return;
    const value = event.target.value;
    apply(value);
    try {
      if (value === 'system') localStorage.removeItem('portal-theme');
      else localStorage.setItem('portal-theme', value);
    } catch { /* Keep the in-page choice even if persistence is blocked. */ }
  });
  window.addEventListener('storage', (event) => {
    if (event.key === 'portal-theme' || event.key === null) apply(event.newValue);
  });
</script>
<style>
  .theme-picker { display: inline-grid; grid-template-columns: repeat(3, 2.25rem); justify-self: end; min-inline-size: 0; margin: 0; padding: 0; border: 0; }
  .theme-picker[hidden] { visibility: hidden; }
  label { position: relative; cursor: pointer; }
  .theme-option { display: grid; place-items: center; min-block-size: 2.75rem; color: var(--ink-quiet); }
  svg { inline-size: 1rem; block-size: 1rem; }
  input:checked + .theme-option { color: var(--ink); box-shadow: inset 0 -2px var(--accent); }
  label:hover .theme-option { color: var(--ink); }
  input:focus-visible + .theme-option { outline: 2px solid var(--accent); outline-offset: 3px; }
</style>
