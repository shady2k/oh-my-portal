---
import Tag from './Tag.astro';

/**
 * The masthead object: the site's name, and under it the corpus split into
 * coloured counts.
 *
 * It is the one loud thing on the site, and it is loud because it is doing two
 * jobs at once — it is the identity *and* the filter. The numbers are article
 * counts, so the shape of the row is the shape of what the author actually
 * writes about: a reader learns the site's subject before reading a word of it,
 * and the row changes on its own as the archive grows.
 *
 * The name is rendered by the caller as the page's heading where it is one, so
 * this component never guesses which heading level it is inside.
 */
interface Props {
  name?: string;
  tags: { tag: string; count: number }[];
  total: number;
  /** The tag whose page we are on, if any. */
  active?: string;
  /** Whether the name is this page's heading. On a tag page it is not. */
  heading?: boolean;
}

const { name, tags, total, active, heading = false } = Astro.props;
---

<div class="mark">
  {name && (heading ? <h1 class="name">{name}</h1> : <p class="name">{name}</p>)}

  {/* One sentence saying what the site is, between the name and the filter —
      the reader learns the subject, then gets the means to narrow it. */}
  <slot />

  <nav class="chips" aria-label="темы">
    <a href="/" class:list={['all', { active: !active }]} aria-current={!active ? 'page' : undefined}>
      все <b>{total}</b>
    </a>
    {tags.map(({ tag, count }) => (
      <Tag tag={tag} href={`/tag/${tag}/`} count={count} active={tag === active} />
    ))}
  </nav>
</div>

<style>
  .mark {
    margin-block: var(--space-4) var(--space-5);
  }

  .name {
    font-size: var(--step-3);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 var(--space-2);
  }

  .mark :global(.bio) {
    max-inline-size: var(--measure);
    margin: 0 0 var(--space-3);
    color: var(--ink-quiet);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* "все" is a chip without a tint: it is the absence of a filter, and giving it
     a colour would make it look like a seventh topic. */
  .all {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    font-family: var(--face-utility);
    font-size: var(--step--1);
    line-height: 1.5;
    border-radius: 0.3em;
    padding: 0.2em 0.55em;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .all b {
    font-weight: 400;
    color: var(--ink-quiet);
  }

  .all:hover,
  .all:focus-visible,
  .all.active {
    box-shadow: inset 0 0 0 1px var(--ink);
  }
</style>
