---
import type { Frontmatter } from '../schema/frontmatter.ts';
import { displayDate } from '../dates.ts';
import PencilRule from './PencilRule.astro';
interface Props {
  revision: NonNullable<Frontmatter['revisions']>[number];
  href?: string;
  title?: string;
  author?: 'human' | 'being';
}
const { revision, href, title, author = 'human' } = Astro.props;
---
<section class="revision" aria-label="Передумал">
  <div class="revision-rule"><PencilRule /></div>
  <header><h2 class="field-label">Передумал{author === 'being' && ' · запись агента'}</h2><time class="utility" datetime={revision.date.toISOString().slice(0, 10)}>{displayDate(revision.date)}</time></header>
  <div class="comparison">
    <div class="before"><p class="label">Раньше</p><p><s>{revision.before}</s></p></div>
    <div class="after"><p class="label">Теперь</p><p>{revision.after}</p>
      <svg class="pencil-underline" viewBox="0 0 400 15" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M3 8 Q124 2 242 7 T397 4 M16 11 Q160 8 288 10 T389 8" /></svg>
    </div>
  </div>
  <p class="reason"><span>Что изменило мнение.</span> {revision.reason}</p>
  {href && <a class="source" href={href}>{title ?? 'Прочитать исходную запись'} ↗</a>}
</section>
<style>
  .revision { padding-block: 0.75rem 2rem; }
  .revision-rule { inline-size: 9rem; max-inline-size: 40%; }
  header { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem 1rem; margin-block: 1rem 1.5rem; }
  h2.field-label { margin: 0; font-family: var(--face-prose); font-size: 1.25rem; font-weight: 600; color: var(--ink); }
  .comparison { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(2rem, 6vw, 5rem); margin-block-end: 0.5rem; font-size: clamp(1.125rem, 2vw, 1.5rem); line-height: 1.4; }
  .label { font-family: var(--face-utility); color: var(--ink-quiet); font-size: 0.8125rem; margin-block-end: 0.75rem; }
  .before { color: var(--ink-quiet); }
  .before s { text-decoration-color: var(--ink-quiet); text-decoration-thickness: 1px; }
  .after { position: relative; padding-block-end: 0.5rem; }
  .pencil-underline { display: block; inline-size: 80%; block-size: 12px; margin-block: -0.9rem 1rem; stroke: var(--accent); stroke-width: 1.4; stroke-linecap: round; opacity: 0.7; }
  .reason { max-inline-size: 48rem; color: var(--ink-quiet); font-size: 1.0625rem; }
  .reason span { color: var(--ink); }
  .source { font-size: 0.9375rem; }
  @media (max-width: 40rem) {
    .comparison { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .after { margin-block-end: 0.5rem; }
  }
</style>
