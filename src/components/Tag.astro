---
/**
 * A topic label, shared by the archive and article margins: the tag's own
 * slug, underlined when it is a link, with no box around it. A box makes a
 * slug look like a code token or a form control; a word in the journal's
 * data face is enough.
 *
 * A count is shown where the chip is a filter and omitted where it is a label —
 * the same object doing two jobs, told apart by whether it carries a number.
 */
interface Props {
  tag: string;
  href?: string;
  count?: number;
  /** The chip for the page you are on. */
  active?: boolean;
}

const { tag, href, count, active = false } = Astro.props;
const Element = href ? 'a' : 'span';
---

<Element
  class:list={['chip', { active }]}
  aria-current={active ? 'page' : undefined}
  {...href ? { href } : {}}
>
  {tag}
  {count !== undefined && <b class="count">{count}</b>}
</Element>

<style>
  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    background: transparent;
    color: var(--ink);
    font-family: var(--face-utility);
    font-size: var(--step--1);
    line-height: 1.5;
    padding: 0.1em 0;
    text-decoration: none;
    white-space: nowrap;
  }

  a.chip {
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .count {
    font-weight: 400;
    color: var(--ink-quiet);
  }

  a.chip:hover,
  a.chip:focus-visible {
    text-decoration-color: var(--ink);
  }

  /* The page you are on: the word is set in ink with the full underline. */
  .chip.active {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--ink);
    text-underline-offset: 0.2em;
  }
</style>
