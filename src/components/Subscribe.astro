---
import { getAuthor } from '../site.ts';

/**
 * Email subscription — R6.
 *
 * Publishing here is rare and unpredictable, which is exactly the case where a
 * reader cannot be expected to come back and check.
 *
 * The form posts to an address from the content repository's data rather than to
 * a constant here: the endpoint proxies to a mail service chosen for regional
 * deliverability (§7), and that is a deployment fact. Without one configured the
 * form is not rendered at all — a subscription box that goes nowhere is worse
 * than no box.
 */
const author = await getAuthor();
const action = author?.subscribe_action;
---

{
  action && (
    <form class="subscribe" method="post" action={action} data-pagefind-ignore>
      <label class="field-label" for="email">
        подписка на новые записи
      </label>
      <div class="row">
        <input id="email" type="email" name="email" required autocomplete="email" placeholder="почта" />
        <button type="submit">подписаться</button>
      </div>
      <p class="utility note">Только новые записи. Отписаться — ссылкой в любом письме.</p>
    </form>
  )
}

<style>
  .subscribe {
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--rule);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-1);
  }

  input {
    flex: 1 1 14rem;
    font-family: var(--face-utility);
    font-size: var(--step-0);
    padding: var(--space-2);
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 0;
  }

  input:focus-visible {
    border-color: var(--ink);
  }

  button {
    font-family: var(--face-utility);
    font-size: var(--step-0);
    padding: var(--space-2) var(--space-3);
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
    border-radius: 0;
    cursor: pointer;
  }

  .note {
    margin-block: var(--space-1) 0;
  }
</style>
