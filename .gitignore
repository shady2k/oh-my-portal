# --- br (beads_rust) ---
# The database is local; the git-tracked source of truth is .beads/issues.jsonl.
# Exact artifact patterns live in .beads/.gitignore
*.db
.beads-credential-key

# --- repowise (local codebase index) ---
# Grows to hundreds of megabytes, and .repowise/.env holds an API key.
.repowise/

# --- build ---
node_modules/
dist/
dist-test*/
.astro/

# --- content ---
# This repository carries the engine and no articles of its own (design §2), and
# 5c1 keeps it that way. A local checkout or symlink of the content repository
# lands here; making it unstageable is cheaper than remembering not to stage it.
/content/
# And without the slash: a trailing slash matches directories only, and a
# symlink to the content repository is not a directory as far as git is
# concerned — so the symlink form showed up as untracked and could be staged.
/content

# Screenshots from scripts/screenshot.ts — look at them, do not commit them.
screenshots/
